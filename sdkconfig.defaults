# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 6.1.0 Project Minimal Configuration
#
# default:
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_OFFSET=0xF000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_SPIRAM=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_KEYING_MATERIAL_EXPORT=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_SPI_FLASH_SUPPORT_ISSI_CHIP=y
CONFIG_SPI_FLASH_SUPPORT_MXIC_CHIP=y
CONFIG_SPI_FLASH_SUPPORT_WINBOND_CHIP=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_SPI_FLASH_SUPPORT_TH_CHIP=y
CONFIG_MBEDTLS_SSL_ALPN=y
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y
CONFIG_APP_GNSS_UART_NUM=1
CONFIG_APP_GNSS_UART_RX_GPIO=2
CONFIG_APP_GNSS_UART_TX_GPIO=3
CONFIG_APP_GNSS_UART_BAUD=115200
# Phase 9C OTA rollback lifecycle
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# V3.0 release 3.0.0
CONFIG_APP_SD_STORAGE_ENABLE=y
# V3.0 release 3.0.0
# Keep mbedTLS record/crypto buffers in internal SRAM. External-PSRAM mbedTLS
# allocation can trigger mspi_psram_isr_handler_wrapper() under TLS AES/SHA DMA.
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
# CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC is not set
# CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC is not set
# CONFIG_MBEDTLS_CUSTOM_MEM_ALLOC is not set


# V3.0 release 3.0.0
# PSRAM remains available explicitly through MALLOC_CAP_SPIRAM. This prevents
# SDMMC/FAT/VFS working buffers from silently landing in encrypted PSRAM where
# ESP32-P4 v1.3 GDMA/MSPI alignment faults have been observed.
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# CONFIG_SPIRAM_USE_MALLOC is not set
# CONFIG_SPIRAM_USE_MEMMAP is not set
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# FATFS work buffers must stay in internal RAM: the SD host DMAs into them,
# and DMA into encrypted PSRAM aborts with "MSPI PSRAM error" during the SD
# mount (seen on TS2). IDF defaults this to y whenever caps-alloc PSRAM is on.
# CONFIG_FATFS_ALLOC_PREFER_EXTRAM is not set

# ESP32-P4 v1.3: do not route peer-certificate ECDSA verification through the
# unsupported ECDSA peripheral. Keep normal software verification enabled.
# This is a narrow management/NTS TLS reliability fix; hardware ECC/AES/SHA
# remain independently configured.
# CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY is not set
