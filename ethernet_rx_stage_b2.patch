@@ -580,6 +582,27 @@ static esp_err_t emac_esp32_transmit_ctrl_vargs(esp_eth_mac_t *mac, void *ctrl,
     return ESP_OK;
 }
 
+bool esp_eth_rx_diag_snapshot(esp_eth_mac_t *mac, esp_eth_rx_diag_t *out)
+{
+    if (mac == NULL || out == NULL) {
+        return false;
+    }
+    emac_esp32_t *emac = __containerof(mac, emac_esp32_t, parent);
+    /* Independent 32-bit atomic loads: approximate snapshot, no DMA traversal. */
+#define RX_DIAG_LOAD(field) out->field = __atomic_load_n(&emac->rx_diag.field, __ATOMIC_RELAXED)
+    RX_DIAG_LOAD(rx_irq);
+    RX_DIAG_LOAD(rx_wakeup);
+    RX_DIAG_LOAD(rx_frame);
+    RX_DIAG_LOAD(rx_alloc_fail);
+    RX_DIAG_LOAD(rx_copy_fail);
+    RX_DIAG_LOAD(rx_truncated);
+    RX_DIAG_LOAD(rx_callback_attempt);
+    RX_DIAG_LOAD(rx_frames_remain);
+    RX_DIAG_LOAD(rx_desc_free);
+#undef RX_DIAG_LOAD
+    return true;
+}
+
 static esp_err_t emac_esp32_receive(esp_eth_mac_t *mac, uint8_t *buf, uint32_t *length)
 {
     esp_err_t ret = ESP_OK;
@@ -604,6 +627,7 @@ static void emac_esp32_rx_task(void *arg)
     while (1) {
         // block indefinitely until got notification from underlay event
         ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
+        __atomic_fetch_add(&emac->rx_diag.rx_wakeup, 1U, __ATOMIC_RELAXED);
         do {
             /* set max expected frame len */
             uint32_t frame_len = ETH_MAX_PACKET_SIZE;
@@ -618,24 +642,31 @@ static void emac_esp32_rx_task(void *arg)
 #endif
                 uint32_t recv_len = emac_esp_dma_receive_frame(emac->emac_dma_hndl, buffer, EMAC_DMA_BUF_SIZE_AUTO, p_ts);
                 if (recv_len == 0) {
+                    __atomic_fetch_add(&emac->rx_diag.rx_copy_fail, 1U, __ATOMIC_RELAXED);
                     ESP_LOGE(TAG, "frame copy error");
                     free(buffer);
                     /* ensures that interface to EMAC does not get stuck with unprocessed frames */
                     emac_esp_dma_flush_recv_frame(emac->emac_dma_hndl);
                 } else if (frame_len > recv_len) {
+                    __atomic_fetch_add(&emac->rx_diag.rx_truncated, 1U, __ATOMIC_RELAXED);
                     ESP_LOGE(TAG, "received frame was truncated");
                     free(buffer);
                 } else {
+                    __atomic_fetch_add(&emac->rx_diag.rx_frame, 1U, __ATOMIC_RELAXED);
                     ESP_LOGD(TAG, "receive len= %" PRIu32, recv_len);
+                    __atomic_fetch_add(&emac->rx_diag.rx_callback_attempt, 1U, __ATOMIC_RELAXED);
                     emac->eth->stack_input_info(emac->eth, buffer, recv_len, (void *)p_ts);
                 }
             /* if allocation failed and there is a waiting frame */
             } else if (frame_len) {
+                __atomic_fetch_add(&emac->rx_diag.rx_alloc_fail, 1U, __ATOMIC_RELAXED);
                 ESP_LOGE(TAG, "no mem for receive buffer");
                 /* ensures that interface to EMAC does not get stuck with unprocessed frames */
                 emac_esp_dma_flush_recv_frame(emac->emac_dma_hndl);
             }
             emac_esp_dma_get_remain_frames(emac->emac_dma_hndl, &emac->frames_remain, &emac->free_rx_descriptor);
+            __atomic_store_n(&emac->rx_diag.rx_frames_remain, emac->frames_remain, __ATOMIC_RELAXED);
+            __atomic_store_n(&emac->rx_diag.rx_desc_free, emac->free_rx_descriptor, __ATOMIC_RELAXED);
 #if CONFIG_ETH_SOFT_FLOW_CONTROL
             // we need to do extra checking of remained frames in case there are no unhandled frames left, but pause frame is still undergoing
             if ((emac->free_rx_descriptor < emac->flow_control_low_water_mark) && emac->do_flow_ctrl && emac->frames_remain) {
@@ -777,6 +808,7 @@ IRAM_ATTR void emac_isr_default_handler(void *args)
 
 #if EMAC_LL_CONFIG_ENABLE_INTR_MASK & EMAC_LL_INTR_RECEIVE_ENABLE
     if (intr_stat & EMAC_LL_DMA_RECEIVE_FINISH_INTR) {
+        __atomic_fetch_add(&emac->rx_diag.rx_irq, 1U, __ATOMIC_RELAXED);
         BaseType_t rx_high_task_woken = pdFALSE;
         /* notify receive task */
         vTaskNotifyGiveFromISR(emac->rx_task_hdl, &rx_high_task_woken);
