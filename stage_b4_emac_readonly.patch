+
+/* Stage B4: observe-only MAC/DMA register sampling. These seven registers
+ * are ordinary RO or R/W storage reads on ESP32-P4. In particular, DMA
+ * STATUS is W1C on WRITE; REG_READ does not acknowledge interrupts.
+ * Never read poll-demand registers, touch descriptor memory, or call HAL
+ * helpers that clear pending interrupts from this diagnostic path.
+ */
+bool esp_eth_rx_hw_diag_snapshot(esp_eth_mac_t *mac, esp_eth_rx_hw_diag_t *out)
+{
+#if CONFIG_IDF_TARGET_ESP32P4
+    if (mac == NULL || out == NULL) {
+        return false;
+    }
+    out->mac_config = REG_READ(EMAC_MACCONFIGURATION_REG);
+    out->dma_status = REG_READ(EMAC_STATUS_REG);
+    out->dma_operation_mode = REG_READ(EMAC_OPERATIONMODE_REG);
+    out->dma_interrupt_enable = REG_READ(EMAC_INTERRUPTENABLE_REG);
+    out->rx_descriptor_list = REG_READ(EMAC_RECEIVEDESCRIPTORLISTADDRESS_REG);
+    out->rx_current_descriptor = REG_READ(EMAC_CURRENTHOSTRECEIVEDESCRIPTOR_REG);
+    out->rx_current_buffer = REG_READ(EMAC_CURRENTHOSTRECEIVEBUFFERADDRESS_REG);
+    return true;
+#else
+    (void)mac;
+    (void)out;
+    return false;
+#endif
 }
 
